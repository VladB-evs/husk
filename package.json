{
  "name": "husk",
  "version": "1.2.1",
  "description": "HUSK - Professional Company Document & Template Editor for macOS",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "build:all": "pnpm build && pnpm electron:build",
    "app": "pnpm electron:build && concurrently -k \"vite\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "pnpm build:all && electron .",
    "test": "vitest run",
    "test:e2e": "pnpm build:all && vitest run --config vitest.e2e.config.ts",
    "package": "pnpm build:all && electron-builder --mac --publish never && cd release && shasum -a 256 *.zip *.dmg > SHA256SUMS",
    "package:dir": "pnpm build:all && electron-builder --mac --dir --publish never",
    "release": "bash scripts/release.sh"
  },
  "keywords": [
    "text-editor",
    "pdf-export",
    "templates",
    "electron",
    "macos"
  ],
  "author": "Vlad B",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-color": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-table-cell": "3.32.0",
    "@tiptap/extension-table-header": "3.32.0",
    "@tiptap/extension-table-row": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/nspell": "^2.1.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.6",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "lowlight": "3.3.0",
    "lucide-react": "1.61.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "6.4.299",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.husk.app",
    "productName": "HUSK",
    "copyright": "Copyright © Vlad B",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "HUSK-${arch}.${ext}"
    },
    "dmg": {
      "title": "HUSK ${version}"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
